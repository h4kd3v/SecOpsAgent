# ---------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit .env.
#   openssl rand -hex 32   ->  SECRET_KEY
# ---------------------------------------------------------------------------

APP_ENV=dev
LOG_LEVEL=INFO

# Signs the anonymous visitor cookie. Rotating it orphans everyone's sidebar
# history (the rows survive; nobody can reach them).
SECRET_KEY=change-me-openssl-rand-hex-32

# Postgres (compose keeps this on the internal network only)
POSTGRES_USER=secops
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=secops_chat

# --- LiteLLM proxy (OpenAI-compatible) -------------------------------------
LLM_PROXY_URL=https://litellm.internal/v1
LLM_API_KEY=sk-...
LLM_MODEL_NAME=gemini-2.5-pro
# Shown under each answer instead of the raw model id the gateway reports.
# Empty = show whatever it reports, which is honest but often an internal alias.
LLM_MODEL_DISPLAY_NAME=

# What each turn costs, so the per-conversation totals are in money and not
# only in tokens. Format: `model=input/output` in dollars per MILLION tokens,
# comma separated. `*` is a fallback for anything unlisted.
#
#   LLM_MODEL_PRICING=gpt-4.1=2.00/8.00
#   LLM_MODEL_PRICING=gpt-4.1=2.00/8.00,claude-opus-5=5.00/25.00,*=1.00/3.00
#
# The rates above are examples — check them against your provider's current
# price list before trusting the totals. Whatever you set is stamped onto each
# turn as it runs, so changing it later never rewrites what past turns cost.
# A model with no entry records no cost at all, which is deliberate: a missing
# number is a gap you can see, a guessed one is a report that is quietly wrong.
# Versioned ids match their family by longest prefix, so `gpt-4.1-2025-04-14`
# bills at the `gpt-4.1` rate while `gpt-4.1-mini` needs its own entry.
LLM_MODEL_PRICING=
LLM_REQUEST_TIMEOUT=180
LLM_MAX_TOOL_ITERATIONS=10
LLM_MAX_CONTEXT_MESSAGES=40
# Character budget for REPLAYED history. Trimming by message count alone is
# meaningless when one UDM search returns half a megabyte. Never trims the
# current turn's tool result. 0 disables it.
LLM_MAX_CONTEXT_CHARS=400000
# 0 = let the proxy decide. A low cap truncates answers mid-sentence and looks
# exactly like a broken stream; the UI raises a warning when it happens.
LLM_MAX_OUTPUT_TOKENS=0
# 0 = the model receives MCP results in full. It is the model that decides
# which tools to call and what the data means, and it cannot reason about rows
# it was never shown. Set a ceiling only if you hit context limits; when it
# bites, the model is told the result was partial so it can narrow the query.
TOOL_RESULT_MAX_CHARS=0

# --- Remote SecOps MCP server ----------------------------------------------
MCP_SERVER_URL=https://secops-mcp.internal/mcp
MCP_TRANSPORT=streamable_http
MCP_TOOL_TIMEOUT=90
# How the Authorization header is produced:
#   service_account - mint a Google token from sa.json (production)
#   static_token    - use MCP_STATIC_TOKEN verbatim, e.g. the output of
#                     `gcloud auth print-access-token`. Expires in ~60 min;
#                     fine for a connectivity test, wrong for a deployment.
#   none            - send no Authorization header at all
MCP_AUTH_MODE=service_account
MCP_STATIC_TOKEN=
# Transport sessions are recycled this often (< the 60-minute token lifetime),
# so a server that pins a session to its opening credential never goes stale.
MCP_SESSION_MAX_AGE=2700

# Sent as headers on EVERY MCP request, alongside `Authorization: Bearer ...`
SECOPS_PROJECT_ID=my-gcp-project
SECOPS_REGION=us
SECOPS_CUSTOMER_ID=01234567-89ab-cdef-0123-456789abcdef

# --- Google service account -------------------------------------------------
# Mounted read-only into the backend container by docker-compose.
GOOGLE_SA_FILE=/run/secrets/sa.json
# access_token -> OAuth2 bearer scoped below (Chronicle / SecOps APIs)
# id_token     -> signed JWT for GOOGLE_ID_TOKEN_AUDIENCE (Cloud Run-hosted MCP)
GOOGLE_TOKEN_TYPE=access_token
GOOGLE_SCOPES=https://www.googleapis.com/auth/cloud-platform
GOOGLE_ID_TOKEN_AUDIENCE=
# Refresh this many seconds before the 60-minute token expires.
GOOGLE_TOKEN_REFRESH_SKEW=300

# --- Tool safety ------------------------------------------------------------
# Fallback classification, used only when the MCP server omits tool annotations.
# `|||`-separated list of regexes; a match means read-only (auto-executes).
# Anything unmatched requires explicit analyst approval in the UI (fail closed).
TOOL_READONLY_PATTERNS=^(get|list|search|lookup|fetch|query|read|describe|show|find|count)_|||^secops_(search|get|list)
TOOL_DENYLIST=
REQUIRE_APPROVAL_FOR_WRITE=true
# Cached in Postgres, re-fetched only when older than this. Survives restarts
# and session recycles; a stale copy is served if the MCP server is down.
TOOL_CACHE_TTL_HOURS=24
TOOL_CACHE_ENABLED=true
# Narrow this: the real SecOps MCP server exposes ~70 tools whose schemas come
# to ~79k tokens sent on EVERY completion. Caching does not reduce that; only
# exposing fewer tools does.
TOOL_ALLOWLIST=
TOOL_DESCRIPTION_MAX_CHARS=1024

# --- Anonymous sessions -----------------------------------------------------
# How long a visitor's cookie, and therefore their sidebar history, lasts.
ANON_SESSION_DAYS=90
# A conversation is created only when the first message is sent, so an empty
# one is debris from a failed first turn. Swept at startup once older than
# this many hours. 0 disables the sweep.
EMPTY_CONVERSATION_TTL_HOURS=24
# One shared workspace: every analyst sees every conversation in their sidebar
# and can contribute to any of them. A shift working one incident together
# beats twenty private transcripts — but there is no privacy between analysts.
# Reading and contributing are shared; renaming and archiving stay with whoever
# started the thread. Set false for per-browser history.
SHARED_WORKSPACE=true
RATE_LIMIT_MESSAGES_PER_MINUTE=20
CORS_ORIGINS=http://localhost:5173

# --- Database pool ----------------------------------------------------------
# Sized against concurrent *turns*, not requests: every in-flight turn holds a
# request-scoped connection plus one for its streaming response, for as long as
# the model takes to answer. ~20 analysts answering at once needs ~40. Postgres
# allows 100 connections by default, so raise that too before going much above
# DB_POOL_SIZE + DB_MAX_OVERFLOW = 60.
DB_POOL_SIZE=40
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10

.env
*.env
!.env.example

# The Google service-account key. Never commit this.
# Ignore the contents but keep the folder, so the compose bind mount has a
# mount point on a fresh clone.
secrets/*
!secrets/README.md
sa.json
*.sa.json

# Database dumps. These hold every analyst's prompts, the model's answers and
# the SecOps data returned to them — the most sensitive content the app has.
# Keep the folder so the backup script has somewhere to write on a fresh clone.
backups/*
!backups/.gitkeep

__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

node_modules/
dist/
tsconfig.tsbuildinfo
*.local
.DS_Store
